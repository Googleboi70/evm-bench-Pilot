# Copy to .env and fill in. NEVER commit .env.
# Any OpenAI-compatible endpoint works. Check your provider's docs for exact model names.
#
# Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1
# DeepSeek:    LLM_BASE_URL=https://api.deepseek.com
# Local mock:  LLM_BASE_URL=http://127.0.0.1:8000/v1   (LLM_API_KEY=dummy)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Minimum seconds between API calls. Use it to stay under free-tier requests-per-minute
# limits (e.g. 12 for a 5 requests/minute limit). 0 = no spacing.
LLM_MIN_INTERVAL=0
